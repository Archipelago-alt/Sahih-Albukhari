# Raw Shamela page cache (re-creatable with tool/import/fetch_shamela.py; ~60 MB)
/data/source/*/raw/
*.tmp

# Generated book data: not committed until the data-licensing decision in
# docs/DATA_LICENSE.md is made. Rebuild with tool/import/build_database.py.
/assets/content/*.db
/assets/content/content_version.json
/data/generated/

